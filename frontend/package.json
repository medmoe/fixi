{
  "name": "system-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "docker run --rm -v $(pwd):/app -w /app node:22-alpine npm run vitest",
    "vitest": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "jest --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "add:pkg": "docker run --rm -v $(pwd):/app -w /app node:22-alpine npm install",
    "clean": "docker run --rm -v $(pwd):/app -w /app node:22-alpine sh -c 'rm -rf node_modules package-lock.json'",
    "fresh": "docker run --rm -v $(pwd):/app -w /app node:22-alpine sh -c 'rm -rf node_modules package-lock.json && npm install'",
    "docker:fresh": "docker compose down -v && docker compose up --build frontend"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "npm": "^11.18.0",
    "radix-ui": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cypress": "^13.13.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^28.1.0",
    "msw": "^2.4.7",
    "tailwindcss": "^4.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^4.1.9"
  }
}
